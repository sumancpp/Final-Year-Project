# Application Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development
DEBUG=True

# Document Storage Settings
UPLOAD_DIR=uploads

# Pipeline Configuration (Thresholds for OCR Confidence Gate)
# When OCR confidence C_ocr is below this threshold, the Vision LLM fallback is triggered
OCR_CONFIDENCE_THRESHOLD=0.85

# Vision LLM Provider Settings (To be configured in later phase)
# Examples: GEMINI, OPENAI, LOCAL
VISION_LLM_PROVIDER=GEMINI
# Do not store production API keys here. Use a local .env file.
# VISION_LLM_API_KEY=your_api_key_here
